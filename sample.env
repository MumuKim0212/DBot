LLM_PROVIDER=claude/openai
ANTHROPIC_API_KEY=your_api_key
OPENAI_API_KEY=your_api_key
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=your_db

# (Optional) For multi-server setup, use DB_SERVERS instead of the MYSQL_* variables above.
# DB_SERVERS='{"kr_live": {"name": "KR Live", "host": "10.0.0.1", "port": 3306, "user": "admin", "password": "pw", "db": "kr_db"}, "na_live": {"name": "NA Live", "host": "10.0.0.2", "port": 3306, "user": "admin", "password": "pw", "db": "na_db"}}'
